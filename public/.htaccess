# =====================================================================
#  Apache: a página inicial é index.html e tudo que começa com /api
#  vai para o api.php (o "front controller" do back-end em PHP).
# =====================================================================
DirectoryIndex index.html

RewriteEngine On
RewriteCond %{REQUEST_URI} ^/api(/|$)
RewriteRule ^ api.php [L,QSA]

# ---- Cabeçalhos de segurança (equivalentes ao helmet) — RNF05 ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://viacep.com.br; font-src 'self'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'; form-action 'self'"
    Header always unset X-Powered-By
</IfModule>
